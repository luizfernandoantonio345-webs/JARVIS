# ──────────────────────────────────────────────────────────────
# JARVIS — Arquivo de configuração de ambiente
# Copie para .env e ajuste os valores para seu ambiente.
# Todas as variáveis têm prefixo JARVIS_ e são opcionais
# (valores default estão indicados nos comentários).
# ──────────────────────────────────────────────────────────────

# ── Caminhos ───────────────────────────────────────────────────
# Diretório base dos jobs do AutoDev Engine
JARVIS_JOBS_DIR=D:/JAVIS/jobs

# Diretórios a monitorar pelo FileSystemWatcher (separados por :)
# Default: diretório raiz do projeto
JARVIS_WATCH_DIRS=D:/JAVIS/backend:D:/JAVIS/frontend

# Arquivo de log do Jarvis para o LogWatcher
JARVIS_LOG_FILE=jarvis.log

# ── LLM ────────────────────────────────────────────────────────
# URL do servidor Ollama (modelo local)
JARVIS_OLLAMA_URL=http://localhost:11434

# Modelo Ollama a usar (deve estar instalado: ollama pull <model>)
JARVIS_LOCAL_MODEL=qwen2:0.5b

# Modelo Claude (Anthropic)
JARVIS_CLAUDE_MODEL=claude-3-haiku-20240307

# Modelo OpenAI
JARVIS_OPENAI_MODEL=gpt-4o-mini

# Chaves de API — deixe vazio para usar apenas Ollama local
JARVIS_ANTHROPIC_API_KEY=
JARVIS_OPENAI_API_KEY=

# Limiar de complexidade para roteamento externo (0.0–1.0, default 0.45)
JARVIS_COMPLEX_THRESHOLD=0.45

# Timeout das APIs externas em segundos
JARVIS_LLM_API_TIMEOUT=45

# ── Autonomia ──────────────────────────────────────────────────
# Habilitar o System Event Loop no startup
JARVIS_AUTONOMY_ENABLED=true

# Máximo de ações autônomas por minuto (evita loop infinito)
JARVIS_AUTONOMY_MAX_ACTIONS_PER_MINUTE=3

# Modo seguro: exige confirmação antes de operações de escrita
JARVIS_AUTONOMY_SAFE_MODE=true

# Minutos de inatividade antes do IdleWatcher disparar
JARVIS_IDLE_TIMEOUT_MINUTES=5

# ── Voz ────────────────────────────────────────────────────────
# Habilitar input/output por voz
JARVIS_VOICE_ENABLED=true

# Wake word para ativação por voz
JARVIS_WAKE_WORD=jarvis

# Idioma do reconhecimento de voz
JARVIS_VOICE_LANGUAGE=pt-BR

# Engine de TTS: pyttsx3 | gTTS | elevenlabs
JARVIS_VOICE_TTS_ENGINE=pyttsx3

# ── Segurança ──────────────────────────────────────────────────
# Tolerância a risco padrão: low | medium | high
# (pode ser sobrescrito pelo BehaviorProfile em runtime)
JARVIS_RISK_TOLERANCE=medium

# Segundos de espera por confirmação antes de cancelar ação
JARVIS_CONFIRMATION_TIMEOUT_SECONDS=30

# ── Memória ────────────────────────────────────────────────────
# Caminho do banco SQLite de memória
JARVIS_MEMORY_DB_PATH=memory.db

# Tamanho máximo do banco antes de cleanup automático (MB)
JARVIS_MEMORY_MAX_SIZE_MB=500

# Dias de histórico a manter no cleanup
JARVIS_MEMORY_RETAIN_DAYS=30

# ── Servidor ───────────────────────────────────────────────────
# Endereço e porta do servidor FastAPI
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# Número de workers Uvicorn (1 para dev, 4+ para produção)
JARVIS_WORKERS=1

# Modo debug (desabilitar em produção)
JARVIS_DEBUG=false
