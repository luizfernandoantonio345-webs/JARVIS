# ─────────────────────────────────────────────────────────────
# JARVIS v10.0 — Configuration Template
# Copy to .env and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── LLM (Ollama local) ───────────────────────────────────────
# Ollama must be running locally: https://ollama.com
JARVIS_OLLAMA_URL=http://127.0.0.1:11434

# Model selection (auto-selected by start.bat based on RAM):
#   < 6GB RAM  -> qwen2:0.5b   (ollama pull qwen2:0.5b)
#   6-12GB RAM -> qwen2:1.5b   (ollama pull qwen2:1.5b)
#   12-28GB    -> llama3.2:3b  (ollama pull llama3.2:3b)
#   32GB+      -> mistral:7b   (ollama pull mistral:7b)
JARVIS_MODEL=qwen2:0.5b
JARVIS_FALLBACK_MODEL=tinyllama
JARVIS_TIMEOUT=90

# ── Server ───────────────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO
JARVIS_SAFE_MODE=true
# Portao do laco de agente: off | trusted | strict
#   off     = nada e checado
#   trusted = padrao; so pede confirmacao no que e irreversivel
#   strict  = toda escrita e comando pedem confirmacao
JARVIS_SAFETY_LEVEL=trusted
# Teto de passos do laco e segundos ate abortar a tarefa
JARVIS_AGENT_MAX_ITERATIONS=25
JARVIS_AGENT_WS_TIMEOUT=900

# ── Escalada para modelo forte quando o local empaca ──────────────────
# off    = nunca escala
# advice = so pede orientacao e continua local
# auto   = orientacao e, se nao resolver, entrega a tarefa (padrao)
JARVIS_ESCALATE=auto
# claude | openai — sem isso usa a primeira chave que encontrar
JARVIS_ESCALATE_PROVIDER=
# Preencha UMA destas para ligar a escalada. Sem chave, ela fica desligada
# e o laco segue so com o modelo local.
JARVIS_ANTHROPIC_API_KEY=
JARVIS_OPENAI_API_KEY=

# ── Security ─────────────────────────────────────────────────
# Leave empty for local-only (no authentication required).
JARVIS_API_KEY=
# AES-256 key for token signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JARVIS_SECRET_KEY=

# ── Voice (TTS/STT) ──────────────────────────────────────────
JARVIS_VOICE_ENABLED=true
# Voz do JARVIS: jarvis | jarvis_en | ultron | operacional | neutro
JARVIS_TTS_PROFILE=jarvis
# Onde o audio toca: browser (orb acompanha a fala) | server
JARVIS_TTS_OUTPUT=browser
JARVIS_TTS_VOICE=pt-BR-AntonioNeural
JARVIS_TTS_RATE=-12%
JARVIS_TTS_PITCH=-15Hz
JARVIS_LANG=pt-BR
JARVIS_USER_TITLE=Senhor

# ── Optional: External APIs (leave empty = fully offline) ────
JARVIS_ANTHROPIC_API_KEY=
