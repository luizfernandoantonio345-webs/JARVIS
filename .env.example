# ── LLM LOCAL ──────────────────────────────────────────────
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_MODEL=mistral:7b
JARVIS_FALLBACK_MODEL=llama3.2:3b
JARVIS_TIMEOUT=120
JARVIS_MAX_RETRIES=2

# ── BACKEND ────────────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_DEBUG=false
JARVIS_LOG_LEVEL=INFO
JARVIS_SAFE_MODE=true

# ── VOZ ────────────────────────────────────────────────────
JARVIS_VOICE_ENABLED=true
JARVIS_TTS_VOICE=en-GB-RyanNeural
JARVIS_TTS_RATE=-5%
JARVIS_TTS_PITCH=-8Hz
JARVIS_USER_TITLE=Sir
JARVIS_LANG=en

# ── ACESSO REMOTO (opcional) ───────────────────────────────
JARVIS_TAILSCALE_IP=

# ── API EXTERNA (opcional, deixar vazio por padrao) ────────
JARVIS_ANTHROPIC_API_KEY=
