# ─────────────────────────────────────────────────────────────
# JARVIS v10.0 — Configuration Template
# Copy to .env and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── LLM (Ollama local) ───────────────────────────────────────
# Ollama must be running locally: https://ollama.com
JARVIS_OLLAMA_URL=http://127.0.0.1:11434

# Model selection (auto-selected by start.bat based on RAM):
#   < 6GB RAM  -> qwen2:0.5b   (ollama pull qwen2:0.5b)
#   6-12GB RAM -> qwen2:1.5b   (ollama pull qwen2:1.5b)
#   12-28GB    -> llama3.2:3b  (ollama pull llama3.2:3b)
#   32GB+      -> mistral:7b   (ollama pull mistral:7b)
JARVIS_MODEL=qwen2:0.5b
JARVIS_FALLBACK_MODEL=tinyllama
JARVIS_TIMEOUT=90

# ── Server ───────────────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO
JARVIS_SAFE_MODE=true

# ── Security ─────────────────────────────────────────────────
# Leave empty for local-only (no authentication required).
JARVIS_API_KEY=
# AES-256 key for token signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JARVIS_SECRET_KEY=

# ── Voice (TTS/STT) ──────────────────────────────────────────
JARVIS_VOICE_ENABLED=true
JARVIS_TTS_VOICE=pt-BR-AntonioNeural
JARVIS_TTS_RATE=-12%
JARVIS_TTS_PITCH=-15Hz
JARVIS_LANG=pt-BR
JARVIS_USER_TITLE=Senhor

# ── Optional: External APIs (leave empty = fully offline) ────
JARVIS_ANTHROPIC_API_KEY=
