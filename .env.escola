# ── JARVIS CONFIG — PC DA ESCOLA (32GB RAM / Ryzen 7) ──────────────────────────
# Copie este arquivo como .env antes de iniciar: copy .env.escola .env

# ── LLM LOCAL ──────────────────────────────────────────────────────────────────
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_MODEL=mistral:7b
JARVIS_FALLBACK_MODEL=llama3.2:3b
JARVIS_TIMEOUT=120
JARVIS_MAX_RETRIES=2

# ── BACKEND ────────────────────────────────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_DEBUG=false
JARVIS_LOG_LEVEL=INFO
JARVIS_SAFE_MODE=true

# ── SEGURANÇA ──────────────────────────────────────────────────────────────────
# Aberto para qualquer origem na rede local da escola (sem HTTPS, sem risco)
JARVIS_CORS_ORIGINS=*
JARVIS_API_KEY=

# ── VOZ ────────────────────────────────────────────────────────────────────────
JARVIS_VOICE_ENABLED=true
JARVIS_TTS_VOICE=en-GB-RyanNeural
JARVIS_TTS_RATE=-5%
JARVIS_TTS_PITCH=-8Hz
JARVIS_USER_TITLE=Sir
JARVIS_LANG=en

# ── PERFORMANCE (32GB — pode usar contexto maior) ──────────────────────────────
JARVIS_TOTAL_RAM_GB=32
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_KEEP_ALIVE=60m
KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=4
JARVIS_HEADSET_MODE=true
