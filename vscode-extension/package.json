{
  "name": "jarvis-vscode",
  "displayName": "JARVIS — AI Code Assistant",
  "description": "Integrates JARVIS AI backend with VS Code: improve, review, and secure your code.",
  "version": "1.0.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Machine Learning"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jarvis.improveCode",
        "title": "Jarvis: Improve Code"
      },
      {
        "command": "jarvis.reviewCode",
        "title": "Jarvis: Review Code"
      },
      {
        "command": "jarvis.securityScan",
        "title": "Jarvis: Security Scan"
      },
      {
        "command": "jarvis.explainCode",
        "title": "Jarvis: Explain Code"
      }
    ],
    "configuration": {
      "title": "JARVIS",
      "properties": {
        "jarvis.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the JARVIS backend API."
        },
        "jarvis.sessionId": {
          "type": "string",
          "default": "vscode-session",
          "description": "Session ID sent to the backend."
        },
        "jarvis.autoConfirm": {
          "type": "boolean",
          "default": false,
          "description": "If true, applies AI changes without a diff preview. NOT recommended."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
